# Django
# Must be unique and secret in production
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SERVE_MEDIA=false

# Optional production hardening overrides
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# CSRF_COOKIE_HTTPONLY=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=false
# CSP_ENFORCE=false

# Database (option 1: connection URL)
# Managed PostgreSQL example:
# postgresql://user:password@host:25060/database?sslmode=verify-full&sslrootcert=/etc/cegarza-db/ca.crt
DATABASE_URL=

# Database (option 2: individual fields)
# SQL_HOST=localhost
# SQL_PORT=5432
# SQL_DATABASE=cegarzablog
# SQL_USER=postgres
# SQL_PASSWORD=

# DigitalOcean Spaces (S3-compatible object storage)
USE_SPACES=false
# SPACES_ACCESS_KEY=
# SPACES_SECRET_KEY=
# SPACES_BUCKET_NAME=
# SPACES_REGION=nyc3
# SPACES_ENDPOINT_URL=
# SPACES_CDN_DOMAIN=

# Wagtail
SITE_NAME=cegarza.com
SITE_DESCRIPTION=Thoughts, stories and ideas.
SITE_AUTHOR=Cesar Garza
WAGTAILADMIN_BASE_URL=http://localhost:8000
# Comma-separated exact HTTPS hosts allowed for sandboxed imported iframes
ALLOWED_EMBED_HOSTS=cesaregarza.github.io
